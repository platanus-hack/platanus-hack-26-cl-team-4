<?xml version="1.0"?>
<robot name="viaz-instalador-ficticio">
  <material name="cuerpo"><color rgba="0.95 0.75 0.1 1"/></material>
  <material name="brazo"><color rgba="0.85 0.85 0.88 1"/></material>
  <material name="negro"><color rgba="0.1 0.1 0.1 1"/></material>

  <link name="base_link">
    <visual><origin xyz="0 0 0.5"/><geometry><box size="1.6 1.0 0.6"/></geometry><material name="cuerpo"/></visual>
    <collision><origin xyz="0 0 0.5"/><geometry><box size="1.6 1.0 0.6"/></geometry></collision>
    <inertial>
      <origin xyz="0 0 0.5"/><mass value="600.0"/>
      <inertia ixx="68.00000" iyy="146.00000" izz="178.00000" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>

  <link name="rueda_0">
    <visual><origin xyz="0 0 0"/><geometry><cylinder radius="0.2" length="0.15"/></geometry><material name="negro"/></visual>
    <collision><origin xyz="0 0 0"/><geometry><cylinder radius="0.2" length="0.15"/></geometry></collision>
    <inertial>
      <origin xyz="0 0 0"/><mass value="15.0"/>
      <inertia ixx="0.17813" iyy="0.17813" izz="0.30000" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>
  <joint name="rueda_0_fija" type="fixed"><parent link="base_link"/><child link="rueda_0"/><origin xyz="0.55 0.55 0.2" rpy="1.5708 0 0"/></joint>

  <link name="rueda_1">
    <visual><origin xyz="0 0 0"/><geometry><cylinder radius="0.2" length="0.15"/></geometry><material name="negro"/></visual>
    <collision><origin xyz="0 0 0"/><geometry><cylinder radius="0.2" length="0.15"/></geometry></collision>
    <inertial>
      <origin xyz="0 0 0"/><mass value="15.0"/>
      <inertia ixx="0.17813" iyy="0.17813" izz="0.30000" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>
  <joint name="rueda_1_fija" type="fixed"><parent link="base_link"/><child link="rueda_1"/><origin xyz="0.55 -0.55 0.2" rpy="1.5708 0 0"/></joint>

  <link name="rueda_2">
    <visual><origin xyz="0 0 0"/><geometry><cylinder radius="0.2" length="0.15"/></geometry><material name="negro"/></visual>
    <collision><origin xyz="0 0 0"/><geometry><cylinder radius="0.2" length="0.15"/></geometry></collision>
    <inertial>
      <origin xyz="0 0 0"/><mass value="15.0"/>
      <inertia ixx="0.17813" iyy="0.17813" izz="0.30000" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>
  <joint name="rueda_2_fija" type="fixed"><parent link="base_link"/><child link="rueda_2"/><origin xyz="-0.55 0.55 0.2" rpy="1.5708 0 0"/></joint>

  <link name="rueda_3">
    <visual><origin xyz="0 0 0"/><geometry><cylinder radius="0.2" length="0.15"/></geometry><material name="negro"/></visual>
    <collision><origin xyz="0 0 0"/><geometry><cylinder radius="0.2" length="0.15"/></geometry></collision>
    <inertial>
      <origin xyz="0 0 0"/><mass value="15.0"/>
      <inertia ixx="0.17813" iyy="0.17813" izz="0.30000" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>
  <joint name="rueda_3_fija" type="fixed"><parent link="base_link"/><child link="rueda_3"/><origin xyz="-0.55 -0.55 0.2" rpy="1.5708 0 0"/></joint>

  <link name="hombro">
    <visual><origin xyz="0 0 0.15"/><geometry><cylinder radius="0.14" length="0.3"/></geometry><material name="brazo"/></visual>
    <collision><origin xyz="0 0 0.15"/><geometry><cylinder radius="0.14" length="0.3"/></geometry></collision>
    <inertial>
      <origin xyz="0 0 0.15"/><mass value="14.963"/>
      <inertia ixx="0.18554" iyy="0.18554" izz="0.14664" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>

  <joint name="shoulder_pan" type="revolute">
    <parent link="base_link"/><child link="hombro"/>
    <origin xyz="0.45 0 0.8"/><axis xyz="0 0 1"/>
    <limit lower="-3.1" upper="3.1" effort="1500" velocity="1.5"/>
    <dynamics damping="5.0" friction="0.0"/>
  </joint>

  <link name="brazo">
    <visual><origin xyz="0 0 0.546"/><geometry><box size="0.16 0.16 1.092"/></geometry><material name="brazo"/></visual>
    <collision><origin xyz="0 0 0.546"/><geometry><box size="0.16 0.16 1.092"/></geometry></collision>
    <inertial>
      <origin xyz="0 0 0.546"/><mass value="22.644"/>
      <inertia ixx="2.29849" iyy="2.29849" izz="0.09661" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>

  <joint name="shoulder_lift" type="revolute">
    <parent link="hombro"/><child link="brazo"/>
    <origin xyz="0 0 0.3"/><axis xyz="0 1 0"/>
    <limit lower="-3.1" upper="3.1" effort="3000" velocity="1.5"/>
    <dynamics damping="5.0" friction="0.0"/>
  </joint>

  <link name="antebrazo">
    <visual><origin xyz="0 0 0.504"/><geometry><box size="0.13 0.13 1.008"/></geometry><material name="brazo"/></visual>
    <collision><origin xyz="0 0 0.504"/><geometry><box size="0.13 0.13 1.008"/></geometry></collision>
    <inertial>
      <origin xyz="0 0 0.504"/><mass value="13.799"/>
      <inertia ixx="1.18782" iyy="1.18782" izz="0.03887" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>

  <joint name="elbow" type="revolute">
    <parent link="brazo"/><child link="antebrazo"/>
    <origin xyz="0 0 1.092"/><axis xyz="0 1 0"/>
    <limit lower="-3.1" upper="3.1" effort="1500" velocity="1.5"/>
    <dynamics damping="5.0" friction="0.0"/>
  </joint>

  <link name="muneca_1">
    <visual><origin xyz="0 0 0.075"/><geometry><cylinder radius="0.07" length="0.15"/></geometry><material name="brazo"/></visual>
    <collision><origin xyz="0 0 0.075"/><geometry><cylinder radius="0.07" length="0.15"/></geometry></collision>
    <inertial>
      <origin xyz="0 0 0.075"/><mass value="1.87"/>
      <inertia ixx="0.00580" iyy="0.00580" izz="0.00458" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>

  <joint name="wrist_1" type="revolute">
    <parent link="antebrazo"/><child link="muneca_1"/>
    <origin xyz="0 0 1.008"/><axis xyz="0 1 0"/>
    <limit lower="-3.1" upper="3.1" effort="400" velocity="1.5"/>
    <dynamics damping="5.0" friction="0.0"/>
  </joint>

  <link name="muneca_2">
    <visual><origin xyz="0 0 0.05"/><geometry><cylinder radius="0.06" length="0.1"/></geometry><material name="brazo"/></visual>
    <collision><origin xyz="0 0 0.05"/><geometry><cylinder radius="0.06" length="0.1"/></geometry></collision>
    <inertial>
      <origin xyz="0 0 0.05"/><mass value="0.916"/>
      <inertia ixx="0.00159" iyy="0.00159" izz="0.00165" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>

  <joint name="wrist_2" type="revolute">
    <parent link="muneca_1"/><child link="muneca_2"/>
    <origin xyz="0 0 0.15"/><axis xyz="0 0 1"/>
    <limit lower="-3.1" upper="3.1" effort="200" velocity="1.5"/>
    <dynamics damping="5.0" friction="0.0"/>
  </joint>

  <link name="efector">
    <visual><origin xyz="0 0 0.025"/><geometry><box size="0.6 1.0 0.05"/></geometry><material name="negro"/></visual>
    <collision><origin xyz="0 0 0.025"/><geometry><box size="0.6 1.0 0.05"/></geometry></collision>
    <inertial>
      <origin xyz="0 0 0.025"/><mass value="6.0"/>
      <inertia ixx="0.50125" iyy="0.18125" izz="0.68000" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>

  <joint name="wrist_3" type="revolute">
    <parent link="muneca_2"/><child link="efector"/>
    <origin xyz="0 0 0.1"/><axis xyz="1 0 0"/>
    <limit lower="-3.1" upper="3.1" effort="200" velocity="1.5"/>
    <dynamics damping="5.0" friction="0.0"/>
  </joint>
</robot>

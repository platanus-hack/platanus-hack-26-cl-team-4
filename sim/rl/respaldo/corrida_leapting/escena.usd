#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    kilogramsPerUnit = 1
    upAxis = "Z"
)

def Xform "World"
{
    def Scope "Materiales"
    {
        def Material "Suelo" (
            prepend apiSchemas = ["PhysicsMaterialAPI"]
        )
        {
            float physics:staticFriction = 0.6
            float physics:dynamicFriction = 0.6
            float physics:restitution = 0.0
        }
        def Material "Acero" (
            prepend apiSchemas = ["PhysicsMaterialAPI"]
        )
        {
            float physics:staticFriction = 0.3
            float physics:dynamicFriction = 0.3
            float physics:restitution = 0.0
        }
        def Material "VisTierra"
        {
            token outputs:surface.connect = </World/Materiales/VisTierra/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.6000, 0.4200, 0.2600)
                float inputs:roughness = 1.0
                float inputs:metallic = 0.0
                token outputs:surface
            }
        }
        def Material "VisCerro"
        {
            token outputs:surface.connect = </World/Materiales/VisCerro/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.4800, 0.3300, 0.2200)
                float inputs:roughness = 1.0
                float inputs:metallic = 0.0
                token outputs:surface
            }
        }
        def Material "VisTubo"
        {
            token outputs:surface.connect = </World/Materiales/VisTubo/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.5500, 0.5700, 0.6000)
                float inputs:roughness = 0.5
                float inputs:metallic = 0.6
                token outputs:surface
            }
        }
        def Material "VisPoste"
        {
            token outputs:surface.connect = </World/Materiales/VisPoste/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.4500, 0.4700, 0.5000)
                float inputs:roughness = 0.5
                float inputs:metallic = 0.6
                token outputs:surface
            }
        }
        def Material "VisPanel"
        {
            token outputs:surface.connect = </World/Materiales/VisPanel/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.0500, 0.1000, 0.3500)
                float inputs:roughness = 0.25
                float inputs:metallic = 0.3
                token outputs:surface
            }
        }
        def Material "VisMarco"
        {
            token outputs:surface.connect = </World/Materiales/VisMarco/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.5500, 0.5700, 0.6000)
                float inputs:roughness = 0.35
                float inputs:metallic = 0.9
                token outputs:surface
            }
        }
        def Material "VisRoca"
        {
            token outputs:surface.connect = </World/Materiales/VisRoca/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.4200, 0.3600, 0.3100)
                float inputs:roughness = 0.9
                float inputs:metallic = 0.0
                token outputs:surface
            }
        }
    }


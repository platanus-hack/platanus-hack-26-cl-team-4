# Comandos del entorno RL para el runner en modo isaac (docs/contrato-entorno-rl.md §1).
# Uso en el pod, desde la raíz del repo:
#   source /workspace/pod.env && source worker-gpu/pod/entorno_rl.env
#   VIAZ_API=... WORKER_TOKEN=... python worker-gpu/runner.py --modo isaac
# El runner corre cada comando desde la raíz del repo: por eso las rutas de los scripts son relativas.
# Cada script fija --headless y activa las cámaras solo si graba video.
export VIAZ_CMD_ENTRENAR="$ISAACLAB_SH -p sim/rl/entrenar.py"
export VIAZ_CMD_EVALUAR="$ISAACLAB_SH -p sim/rl/evaluar.py"
export VIAZ_CMD_GRABAR_CLIP="$ISAACLAB_SH -p sim/rl/grabar_clip.py"
export VIAZ_CMD_VALIDAR_ROBOT="$ISAACLAB_SH -p sim/rl/validar_robot.py"
# Checkpoints y archivos de cada corrida. Fuera del repo, para que un `git clean` no los borre.
export VIAZ_DIR_POD="${VIAZ_DIR_POD:-/workspace/corridas}"
# Agarre del entorno: "union" (unión fija, por defecto) o "succion" (plan B). Ver docs/escena-isaac.md.
# export VIAZ_AGARRE=succion
# Medición del parque en los videos (agente Entorno, trabajo medir_entorno). Entorno aparte del de Isaac:
# bash worker-gpu/pod/instalar_medicion.sh. Sin SAM 3 (login en Hugging Face), mide solo con la nube de puntos.
export VIAZ_PYTHON_MEDIR="${VIAZ_PYTHON_MEDIR:-/venv/medicion/bin/python}"

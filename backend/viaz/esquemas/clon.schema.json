{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "clon.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "robot_id",
    "usd",
    "urdf",
    "escala",
    "diferencias_con_real",
    "validado_en_escena"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "robot_id": {
      "type": "string"
    },
    "usd": {
      "type": [
        "string",
        "null"
      ]
    },
    "urdf": {
      "description": "robot.urdf del clon. null si el clon es un modelo del fabricante sin URDF propio.",
      "type": ["string", "null"]
    },
    "modelo": {
      "description": "Clon que es el modelo publicado del robot para Isaac Lab (fabricante o NVIDIA), en vez de un ensamblaje de piezas. Sin piezas ni geometría de brazo.",
      "type": "object",
      "additionalProperties": false,
      "required": ["fuente", "cfg", "usd"],
      "properties": {
        "fuente": { "enum": ["isaac_lab"] },
        "cfg": { "type": "string", "description": "módulo:objeto del ArticulationCfg (ej.: isaaclab_assets.robots.unitree:H1_CFG)" },
        "usd": { "type": "string", "description": "Ruta del USD en los assets de Isaac (Isaac/...)" }
      }
    },
    "piezas": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "base",
        "brazo",
        "efector"
      ],
      "properties": {
        "base": {
          "type": "string"
        },
        "brazo": {
          "type": "string"
        },
        "efector": {
          "type": "string"
        }
      }
    },
    "escala": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "alcance_m",
        "carga_util_kg"
      ],
      "properties": {
        "alcance_m": {
          "type": "number"
        },
        "carga_util_kg": {
          "type": "number"
        }
      }
    },
    "geometria": {
      "description": "Medidas del clon que usa el plan de la tarea. Coinciden con robot.urdf.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "l1_m",
        "l2_m",
        "muneca_m",
        "montaje_x_m",
        "hombro_z_m",
        "cubierta_z_m",
        "pila_x_m"
      ],
      "properties": {
        "l1_m": {
          "type": "number"
        },
        "l2_m": {
          "type": "number"
        },
        "muneca_m": {
          "type": "number"
        },
        "montaje_x_m": {
          "type": "number"
        },
        "hombro_z_m": {
          "type": "number"
        },
        "cubierta_z_m": {
          "type": "number"
        },
        "pila_x_m": {
          "type": "number"
        },
        "medio_ancho_m": {
          "type": "number",
          "description": "Medio ancho del vehículo. Solo en robots con ficha física; sin él, el plan usa 0,5 m."
        }
      }
    },
    "diferencias_con_real": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "validado_en_escena": {
      "type": "boolean"
    },
    "fidelidad": {
      "description": "Qué tan fiel es el clon al robot real. generico: base genérica, sin bloque fisica. medido: usa el bloque fisica de la ficha, con datos publicados o medidos en fotos. verificado: medido, sin claves fisica.* en estimados, y pasó validar_robot y la rúbrica de calidad. El código escribe solo generico o medido.",
      "enum": [
        "generico",
        "medido",
        "verificado"
      ]
    },
    "construccion": {
      "description": "Cómo se armó el clon: agente constructor, respaldo determinista (RF-CLO-07) o modelo comprobado reusado de una corrida anterior (RF-CLO-10).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "metodo",
        "intentos",
        "ensamblaje",
        "robot_cfg"
      ],
      "properties": {
        "metodo": {
          "enum": [
            "agente",
            "determinista",
            "comprobado"
          ]
        },
        "intentos": {
          "type": "integer",
          "minimum": 0
        },
        "ensamblaje": {
          "type": [
            "string",
            "null"
          ]
        },
        "robot_cfg": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  },
  "if": { "not": { "required": ["modelo"] } },
  "then": { "required": ["piezas", "geometria"] }
}

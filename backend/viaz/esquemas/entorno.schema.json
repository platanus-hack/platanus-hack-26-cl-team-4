{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "entorno.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "tipo", "videos", "terreno", "filas", "estructura", "panel", "escena_usd", "fondo_reconstruido_usd", "confianza"],
  "properties": {
    "version": { "const": 1 },
    "tipo": { "enum": ["parque_solar"] },
    "videos": { "type": "array", "items": { "type": "string" } },
    "terreno": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pendiente_grados", "suelo"],
      "properties": {
        "pendiente_grados": { "type": "number", "minimum": 0, "maximum": 30 },
        "suelo": { "type": "string" },
        "friccion": { "type": "number", "minimum": 0.1, "maximum": 1.5 }
      }
    },
    "filas": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cantidad", "largo_m", "separacion_m"],
      "properties": {
        "cantidad": { "type": "integer", "minimum": 1, "maximum": 20 },
        "largo_m": { "type": "number", "minimum": 5, "maximum": 500 },
        "separacion_m": { "type": "number", "minimum": 2, "maximum": 20 }
      }
    },
    "estructura": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tipo", "altura_m", "inclinacion_grados"],
      "properties": {
        "tipo": { "enum": ["tracker_1_eje", "fijo"] },
        "altura_m": { "type": "number", "minimum": 0.5, "maximum": 4 },
        "inclinacion_grados": { "type": "number", "minimum": -60, "maximum": 60 }
      }
    },
    "panel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["largo_m", "ancho_m", "peso_kg"],
      "properties": {
        "largo_m": { "type": "number", "minimum": 0.5, "maximum": 3 },
        "ancho_m": { "type": "number", "minimum": 0.5, "maximum": 2 },
        "peso_kg": { "type": "number", "minimum": 5, "maximum": 60 }
      }
    },
    "escena_usd": { "type": "string" },
    "fondo_reconstruido_usd": { "type": ["string", "null"] },
    "confianza": { "type": "object", "additionalProperties": { "type": "number", "minimum": 0, "maximum": 1 } },
    "mediciones": {
      "description": "Opcional. De dónde sale cada dato: medido en los videos (medidas_entorno.json) o estimado por el agente.",
      "type": "object",
      "additionalProperties": false,
      "required": ["fuente", "medidos", "ajustes"],
      "properties": {
        "fuente": { "type": "string" },
        "medidos": { "type": "array", "items": { "type": "string" } },
        "ajustes": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["campo", "medido", "final", "razon"],
            "properties": {
              "campo": { "type": "string" },
              "medido": { "type": ["number", "string"] },
              "final": { "type": ["number", "string"] },
              "razon": { "type": "string" }
            }
          }
        },
        "avisos": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}

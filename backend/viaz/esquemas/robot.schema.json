{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "robot.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "id",
    "nombre",
    "fabricante",
    "tipo",
    "ficticio",
    "carga_util_kg",
    "alcance_m",
    "velocidad_base_m_s",
    "efector",
    "fuente",
    "justificacion",
    "alternativas"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "nombre": {
      "type": "string"
    },
    "fabricante": {
      "type": "string"
    },
    "tipo": {
      "enum": [
        "base_movil_brazo",
        "brazo_fijo",
        "vehiculo_con_brazo"
      ]
    },
    "ficticio": {
      "type": "boolean"
    },
    "carga_util_kg": {
      "type": "number",
      "minimum": 0
    },
    "alcance_m": {
      "type": "number",
      "minimum": 0.3,
      "maximum": 6
    },
    "velocidad_base_m_s": {
      "type": "number",
      "minimum": 0
    },
    "efector": {
      "enum": [
        "ventosa",
        "pinza"
      ]
    },
    "fuente": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "url",
        "consultado"
      ],
      "properties": {
        "url": {
          "type": [
            "string",
            "null"
          ]
        },
        "consultado": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "justificacion": {
      "type": "string"
    },
    "alternativas": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "por_que_no"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "por_que_no": {
            "type": "string"
          }
        }
      }
    },
    "origen": {
      "description": "De dónde viene la ficha. Sin el campo, `catalogo`. Una ficha `busqueda` vive en el catálogo compartido del almacén (catalogo/encontrados/<id>.json) hasta que un PR la pasa a catalogo/robots/.",
      "enum": [
        "catalogo",
        "busqueda"
      ]
    },
    "capacidades": {
      "description": "Tareas que el robot hace según su fuente (por ejemplo, instalar_panel).",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "evidencia": {
      "description": "Fuente de cada dato publicado. Clave: nombre de la spec (carga_util_kg, alcance_m, velocidad_base_m_s, efector, tipo, fisica.<campo>). Valor: la URL y la oración exacta de la fuente. Una ficha `busqueda` tiene, para cada spec de selección, una entrada aquí o en `estimados`.",
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "url",
          "cita"
        ],
        "properties": {
          "url": {
            "type": "string",
            "pattern": "^https?://"
          },
          "cita": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "estimados": {
      "description": "Specs que el fabricante NO publica y que estimamos, con el motivo. El agente y la web deben decirlo.",
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "fisica": {
      "description": "Medidas físicas propias del robot. Con este bloque, el clon usa estas medidas en vez de la base genérica (backend/viaz/urdf.py). El núcleo es obligatorio; el resto es opcional y, si falta, el clon usa el valor genérico o no dibuja la pieza. Lo que el fabricante no publica va también en `estimados`.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "largo_m",
        "ancho_m",
        "masa_kg",
        "altura_cubierta_m",
        "traccion"
      ],
      "dependentRequired": {
        "gabinete_largo_m": ["gabinete_alto_m"],
        "gabinete_alto_m": ["gabinete_largo_m"],
        "ventosa_largo_m": ["ventosa_ancho_m"],
        "ventosa_ancho_m": ["ventosa_largo_m"],
        "remolque_largo_m": ["remolque_masa_kg"],
        "remolque_masa_kg": ["remolque_largo_m"]
      },
      "properties": {
        "largo_m": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "ancho_m": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "masa_kg": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "Masa del vehículo con su brazo, sin el remolque."
        },
        "traccion": {
          "enum": [
            "orugas",
            "ruedas"
          ]
        },
        "pila_x_m": {
          "type": "number",
          "description": "Centro de la pila de paneles sobre la cubierta, desde el centro del vehículo. Positivo hacia adelante. Solo sin remolque; sin el campo, la pila va en la parte libre de la cubierta, lejos del gabinete."
        },
        "altura_cubierta_m": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "brazo_x_m": {
          "type": "number",
          "description": "Eje vertical del brazo, desde el centro del vehículo. Positivo hacia adelante."
        },
        "gabinete_largo_m": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "gabinete_alto_m": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "brazo_grosor_m": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "antebrazo_grosor_m": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "ventosa_largo_m": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "Marco de ventosas, a lo largo del antebrazo."
        },
        "ventosa_ancho_m": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "remolque_largo_m": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "Remolque de paneles que el robot arrastra; la pila va sobre él."
        },
        "remolque_masa_kg": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    }
  }
}
